<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  
  <title>د. أبو اليقظان باكلي | البوابة التعريفية الرسمية • Dr. Aboulyakdane BAKELLI</title>
  <meta name="description" content="البوابة الرسمية لـ د. أبو اليقظان باكلي - مدير حاضنة الأعمال TECHINNOV بجامعة العلوم والتكنولوجيا هواري بومدين (USTHB)، أستاذ محاضر وباحث في الجيولوجيا، مهندس ابتكار وتطوير منظومات ريادة الأعمال.">
  <meta name="author" content="Dr. Aboulyakdane BAKELLI">
  
  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="profile">
  <meta property="og:title" content="د. أبو اليقظان باكلي | مدير حاضنة TECHINNOV - USTHB">
  <meta property="og:description" content="أستاذ محاضر وباحث • مدير حاضنة الأعمال TECHINNOV بجامعة العلوم والتكنولوجيا هواري بومدين (USTHB)">
  <meta property="og:image" content="portrait.jpg">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;600;700;800;900&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      /* Sovereign Emerald & Official State Gold Tokens */
      --bg-deep: #030906;
      --bg-emerald-dark: #071912;
      --surface-glass: rgba(9, 28, 19, 0.85);
      --surface-card: linear-gradient(180deg, rgba(15, 42, 29, 0.94) 0%, rgba(5, 14, 10, 0.98) 100%);
      --surface-card-hover: linear-gradient(180deg, rgba(22, 60, 42, 0.96) 0%, rgba(8, 22, 16, 0.99) 100%);
      --gold: #D4AF37;
      --gold-bright: #FFF3B8;
      --gold-pale: #F5E6A3;
      --gold-dark: #9B7415;
      --gold-muted: #C8A656;
      --crimson-seal: #A91B22;
      --crimson-glow: rgba(169, 27, 34, 0.45);
      --text-white: #FFFFFF;
      --text-light: #DCE5E0;
      --text-dim: #9EB0A6;
      --edge-gold: 1px solid rgba(212, 175, 55, 0.38);
      --edge-gold-strong: 1px solid rgba(245, 230, 163, 0.65);
      
      /* Fonts */
      --font-ar-serif: 'Amiri', 'Cairo', serif;
      --font-ar-sans: 'Cairo', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-latin: 'Montserrat', sans-serif;
      
      /* Radii & Curves */
      --r-lg: 20px;
      --r-md: 14px;
      --r-sm: 8px;
      --r-pill: 999px;
      --ease-luxury: cubic-bezier(0.23, 1, 0.32, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      background-color: var(--bg-deep);
      color: var(--text-white);
      font-family: var(--font-ar-sans);
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      min-height: 100dvh;
      background:
        radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.16) 0%, transparent 55%),
        radial-gradient(circle at 50% 45%, rgba(13, 56, 37, 0.38) 0%, transparent 70%),
        var(--bg-deep);
      overflow-x: hidden;
      position: relative;
      line-height: 1.6;
    }

    /* Ambient Canvas */
    #particles-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* ==========================================================================
       LUXURY SOVEREIGN PRELOADER
       ========================================================================== */
    .preloader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: var(--bg-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.7s ease;
    }

    .preloader.is-hidden {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.04);
      filter: blur(6px);
      pointer-events: none;
    }

    .preloader-backdrop {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 40%, rgba(212, 175, 55, 0.22) 0%, rgba(7, 25, 18, 0.65) 50%, var(--bg-deep) 90%),
        radial-gradient(circle at 20% 80%, rgba(13, 56, 37, 0.3) 0%, transparent 60%);
      pointer-events: none;
    }

    .preloader-inner {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 24px;
      text-align: center;
      max-width: 320px;
      width: 100%;
    }

    .preloader-emblem-wrap {
      position: relative;
      width: 90px;
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .preloader-glow-aura {
      position: absolute;
      inset: -12px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.45) 0%, rgba(255, 243, 184, 0.15) 45%, transparent 70%);
      filter: blur(10px);
      animation: auraPulse 2.4s ease-in-out infinite;
    }

    .preloader-ring-pulse {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1px solid rgba(212, 175, 55, 0.5);
      animation: ripplePulse 2s ease-out infinite;
    }

    .preloader-ring-outer {
      position: absolute;
      inset: 2px;
      border-radius: 50%;
      border: 2px dashed rgba(212, 175, 55, 0.7);
      animation: spinClockwise 12s linear infinite;
    }

    .preloader-ring-inner {
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      border: 2px solid transparent;
      border-top-color: var(--gold-bright);
      border-right-color: var(--gold);
      animation: spinCounter 1.8s cubic-bezier(0.68, -0.25, 0.27, 1.25) infinite;
    }

    .preloader-center-seal {
      position: relative;
      z-index: 2;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #153e2b 0%, #06150f 100%);
      border: 1px solid rgba(255, 243, 184, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 16px rgba(212, 175, 55, 0.45);
    }

    .preloader-seal-svg {
      width: 24px;
      height: 24px;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }

    .preloader-identity {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .preloader-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--gold-bright);
      font-family: var(--font-ar-serif);
      letter-spacing: 0.02em;
      text-shadow: 0 2px 8px rgba(0,0,0,0.7);
    }

    .preloader-inst {
      font-size: 0.75rem;
      color: var(--text-dim);
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .preloader-bar-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 4px;
    }

    .preloader-bar-track {
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 99px;
      overflow: hidden;
      border: 1px solid rgba(212, 175, 55, 0.25);
      position: relative;
    }

    .preloader-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #9B7415 0%, #D4AF37 50%, #FFF3B8 100%);
      border-radius: 99px;
      box-shadow: 0 0 12px rgba(255, 243, 184, 0.9);
      transition: width 0.12s ease;
    }

    .preloader-status-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
    }

    .preloader-label {
      color: var(--text-dim);
      font-weight: 500;
    }

    .preloader-percent {
      font-family: var(--font-latin);
      font-weight: 700;
      color: var(--gold-pale);
    }

    @keyframes auraPulse {
      0%, 100% { transform: scale(0.95); opacity: 0.45; }
      50% { transform: scale(1.15); opacity: 0.85; }
    }

    @keyframes ripplePulse {
      0% { transform: scale(0.85); opacity: 0.8; }
      100% { transform: scale(1.4); opacity: 0; }
    }

    @keyframes spinClockwise {
      to { transform: rotate(360deg); }
    }

    @keyframes spinCounter {
      to { transform: rotate(-360deg); }
    }

    /* Portal Container */
    .portal-container {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 480px;
      margin-inline: auto;
      padding: 18px 16px 56px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* Top Language Bar */
    .lang-bar {
      display: flex;
      justify-content: center;
      gap: 8px;
    }

    .lang-btn {
      background: rgba(8, 26, 18, 0.85);
      color: var(--gold-muted);
      border: 1px solid rgba(212, 175, 55, 0.32);
      padding: 6px 18px;
      border-radius: var(--r-pill);
      font-family: var(--font-ar-sans);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      min-height: 36px;
      transition: all 0.25s ease;
      backdrop-filter: blur(8px);
    }

    .lang-btn.active,
    .lang-btn:hover {
      background: linear-gradient(135deg, #D4AF37 0%, #9E7818 100%);
      color: #04100A;
      border-color: var(--gold-bright);
      box-shadow: 0 0 16px rgba(212, 175, 55, 0.45);
    }

    /* Sovereign Institutional Header */
    .sovereign-header {
      text-align: center;
      background: var(--surface-card);
      border: var(--edge-gold);
      border-radius: var(--r-lg);
      padding: 16px 14px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(10px);
    }

    .header-crest {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 72px;
      height: 48px;
      aspect-ratio: 368 / 278;
      border-radius: 8px;
      overflow: hidden;
      border: 1.5px solid var(--gold-pale);
      margin-bottom: 12px;
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.4), 0 4px 14px rgba(0, 0, 0, 0.85);
      background: #000;
      position: relative;
    }

    .header-crest::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 6px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0) 50%);
      pointer-events: none;
    }

    .flag-crest-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .republic-ar {
      font-family: var(--font-ar-serif);
      font-size: 1.08rem;
      color: var(--gold-pale);
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .republic-en {
      font-family: var(--font-latin);
      font-size: 0.68rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold-muted);
      margin-top: 2px;
      font-weight: 600;
    }

    .header-rule {
      width: 60%;
      height: 1px;
      margin: 10px auto;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }

    .org-title {
      font-size: 1.04rem;
      font-weight: 800;
      color: var(--text-white);
      line-height: 1.35;
    }

    .org-sub {
      font-size: 0.83rem;
      color: var(--text-light);
      margin-top: 4px;
      line-height: 1.45;
    }

    .pillars-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      padding: 4px 16px;
      border-radius: var(--r-pill);
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.45);
      color: var(--gold-bright);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    /* ==========================================================================
       HERO PORTRAIT & STRICT GOLD CONTAINER OVERLAY INSIDE PICTURE
       ========================================================================== */
    .hero-section {
      width: 100%;
    }

    .hero-portrait-frame {
      position: relative;
      width: 100%;
      max-width: 440px;
      margin-inline: auto;
      /* Exact dimensions of portrait (682 x 1024) */
      aspect-ratio: 682 / 1024;
      container-type: inline-size;
      border-radius: var(--r-lg);
      overflow: hidden;
      border: var(--edge-gold-strong);
      box-shadow:
        0 22px 55px rgba(0, 0, 0, 0.9),
        0 0 30px rgba(212, 175, 55, 0.25);
      background: #040E09;
      transition: transform 0.4s var(--ease-luxury), box-shadow 0.4s ease;
    }

    .hero-portrait-frame::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -150%;
      width: 70%;
      height: 200%;
      background: linear-gradient(90deg, transparent 0%, rgba(255, 243, 184, 0.14) 50%, transparent 100%);
      transform: rotate(25deg);
      pointer-events: none;
      animation: portraitShimmer 5.5s ease-in-out infinite;
      z-index: 2;
    }

    @keyframes portraitShimmer {
      0%, 70% { left: -150%; }
      100% { left: 160%; }
    }

    .hero-img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.6s var(--ease-luxury);
    }

    .hero-portrait-frame:hover .hero-img {
      transform: scale(1.02);
    }

    /* Coordinates locked strictly to the black & gold box inside the portrait */
    .picture-gold-box-content {
      position: absolute;
      top: 70.0%;
      bottom: 11.2%;
      left: 6.8%;
      right: 6.8%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1cqw 3cqw;
      pointer-events: none;
    }

    .verified-mini-badge {
      display: inline-flex;
      align-items: center;
      gap: 1.2cqw;
      padding: 0.5cqw 2.6cqw;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.16);
      border: 1px solid rgba(245, 230, 163, 0.45);
      color: var(--gold-bright);
      font-size: 2.35cqw;
      font-weight: 700;
      animation: badgePulse 3s infinite ease-in-out;
    }

    @keyframes badgePulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.35); }
      50% { box-shadow: 0 0 8px 1px rgba(255, 243, 184, 0.45); }
    }
      margin-bottom: 0.6cqw;
      backdrop-filter: blur(4px);
    }

    .verified-mini-badge svg {
      width: 2.8cqw;
      height: 2.8cqw;
      fill: var(--gold-bright);
    }

    .person-name-ar {
      margin: 0;
      font-family: var(--font-ar-serif);
      font-size: 6.2cqw;
      font-weight: 700;
      line-height: 1.15;
      background: linear-gradient(180deg, #FFFFFF 0%, #FFF2B2 35%, #D4AF37 75%, #9E7614 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.95));
    }

    .person-name-en {
      margin-top: 0.4cqw;
      font-family: var(--font-latin);
      font-size: 2.5cqw;
      font-weight: 700;
      letter-spacing: 0.24em;
      color: var(--gold-pale);
      text-transform: uppercase;
    }

    .gold-divider {
      width: 44%;
      height: 1px;
      margin: 1cqw auto;
      background: linear-gradient(90deg, transparent, var(--gold-bright), transparent);
    }

    .person-title {
      margin: 0;
      font-family: var(--font-ar-sans);
      font-size: 3.05cqw;
      font-weight: 700;
      line-height: 1.32;
      color: #FFFFFF;
      text-shadow: 0 2px 5px rgba(0, 0, 0, 0.95);
      max-width: 96%;
    }

    /* Legal Authority Crimson/Gold Banner */
    .authority-banner {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 16px;
      border-radius: var(--r-md);
      background: linear-gradient(135deg, rgba(169, 27, 34, 0.94) 0%, rgba(105, 12, 18, 0.97) 100%);
      border: 1px solid rgba(245, 230, 163, 0.55);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.65);
    }

    .authority-banner-icon {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid var(--gold-pale);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-bright);
    }

    .authority-banner-icon svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .authority-banner-text {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .authority-banner-text strong {
      font-size: 0.9rem;
      color: #FFFFFF;
      line-height: 1.35;
      font-weight: 800;
    }

    .authority-banner-text span {
      font-size: 0.77rem;
      color: var(--gold-bright);
      line-height: 1.35;
    }

    /* Executive Action Buttons */
    .cta-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .btn-executive {
      width: 100%;
      min-height: 52px;
      padding: 12px 18px;
      border-radius: var(--r-md);
      font-family: var(--font-ar-sans);
      font-size: 0.95rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      text-decoration: none;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s var(--ease-luxury), box-shadow 0.25s ease;
    }

    .btn-executive::after {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
      transform: skewX(-25deg);
      transition: left 0.6s ease;
      pointer-events: none;
    }

    .btn-executive:hover::after {
      left: 140%;
    }

    #btn-top-whatsapp {
      animation: waPulse 2.8s infinite ease-in-out;
    }

    @keyframes waPulse {
      0%, 100% {
        box-shadow: 0 4px 14px rgba(37, 211, 102, 0.2);
      }
      50% {
        box-shadow: 0 4px 22px rgba(37, 211, 102, 0.55), 0 0 0 4px rgba(37, 211, 102, 0.12);
      }
    }

    .btn-executive svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .btn-gold-primary {
      background: linear-gradient(135deg, #F5E6A3 0%, #D4AF37 50%, #9E7614 100%);
      color: #05120C;
      border: 1px solid #FFF5C0;
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.35);
    }

    .btn-gold-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(212, 175, 55, 0.52);
    }

    .btn-emerald-outline {
      background: var(--surface-card);
      color: var(--gold-bright);
      border: var(--edge-gold-strong);
    }

    .btn-emerald-outline:hover {
      transform: translateY(-2px);
      background: rgba(18, 52, 36, 0.95);
    }

    /* Official Credential Data Card */
    .credential-card {
      background: var(--surface-card);
      border: var(--edge-gold);
      border-radius: var(--r-lg);
      padding: 18px 16px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7);
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.22);
    }

    .section-header svg {
      width: 20px;
      height: 20px;
      fill: var(--gold);
      flex-shrink: 0;
    }

    .section-header h2 {
      font-size: 1rem;
      color: var(--gold-pale);
      font-weight: 700;
    }

    .cred-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .cred-item {
      background: rgba(3, 10, 7, 0.65);
      border: 1px solid rgba(212, 175, 55, 0.2);
      border-radius: 10px;
      padding: 10px 12px;
    }

    .cred-item-full {
      grid-column: 1 / -1;
    }

    .cred-item dt {
      font-size: 0.74rem;
      color: var(--gold-muted);
      margin-bottom: 4px;
      font-weight: 600;
    }

    .cred-item dd {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-white);
      word-break: break-word;
    }

    .mono-gold {
      font-family: var(--font-latin);
      color: var(--gold-bright) !important;
      letter-spacing: 0.05em;
    }

    .gold-highlight {
      color: var(--gold-bright) !important;
      font-size: 0.95rem !important;
    }

    /* Strategic Pillars */
    .tier-heading {
      font-size: 1rem;
      color: var(--gold-pale);
      margin-bottom: 12px;
      text-align: center;
      font-weight: 700;
    }

    .pillars-stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .pillar-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: var(--surface-card);
      border: var(--edge-gold);
      border-radius: var(--r-md);
      padding: 14px;
      transition: transform 0.25s var(--ease-luxury), border-color 0.25s;
    }

    .pillar-card:hover {
      transform: translateY(-2px);
      border-color: var(--gold-pale);
    }

    .pillar-icon-wrap {
      flex-shrink: 0;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.35);
      color: var(--gold-bright);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pillar-icon-wrap svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .pillar-body h3 {
      font-size: 0.94rem;
      color: var(--gold-pale);
      margin-bottom: 4px;
      font-weight: 700;
    }

    .pillar-body p {
      font-size: 0.81rem;
      color: var(--text-light);
      line-height: 1.5;
    }

    /* Direct Contact Options */
    .contact-pills {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .contact-pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 10px 18px;
      border-radius: var(--r-pill);
      background: rgba(10, 32, 22, 0.85);
      border: var(--edge-gold);
      color: var(--text-white);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .contact-pill svg {
      width: 18px;
      height: 18px;
      fill: var(--gold);
    }

    .contact-pill:hover {
      background: rgba(212, 175, 55, 0.2);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
    }

    /* Legal Directives */
    .legal-directives {
      background: rgba(6, 18, 13, 0.92);
      border: var(--edge-gold);
      border-radius: var(--r-md);
      padding: 16px;
    }

    .legal-title {
      font-size: 0.9rem;
      color: var(--gold-pale);
      margin-bottom: 10px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .legal-title svg {
      width: 18px;
      height: 18px;
      fill: var(--gold);
    }

    .legal-list {
      padding-inline-start: 18px;
      font-size: 0.79rem;
      color: var(--text-light);
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .un-citation {
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px dashed rgba(212, 175, 55, 0.3);
      font-size: 0.76rem;
      color: var(--gold-bright);
      text-align: center;
      line-height: 1.5;
      font-weight: 600;
    }

    /* Footer */
    .portal-footer {
      text-align: center;
      padding-top: 12px;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .footer-org {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--gold-pale);
    }

    .footer-sub {
      font-size: 0.76rem;
      color: var(--text-light);
    }

    .footer-copy {
      font-family: var(--font-latin);
      font-size: 0.72rem;
      color: var(--gold-muted);
      margin-top: 6px;
    }

    .footer-agency-link {
      color: var(--gold-muted);
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .footer-agency-link:hover {
      color: var(--gold-bright);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .toast-msg {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: linear-gradient(135deg, #D4AF37 0%, #9E7818 100%);
      color: #04100A;
      padding: 10px 22px;
      border-radius: var(--r-pill);
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 10px 25px rgba(0,0,0,0.8);
      z-index: 2000;
      opacity: 0;
      transition: all 0.35s var(--ease-luxury);
      pointer-events: none;
    }

    .toast-msg.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    /* Scroll Reveal */
    .anim-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.65s var(--ease-luxury), transform 0.65s var(--ease-luxury);
    }

    .anim-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Executive Bio Card */
    .bio-card {
      background: var(--surface-card);
      border: var(--edge-gold);
      border-radius: var(--r-lg);
      padding: 20px 18px;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.7);
      position: relative;
    }

    .bio-card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(212, 175, 55, 0.22);
    }

    .bio-card-header svg {
      width: 20px;
      height: 20px;
      fill: var(--gold);
      flex-shrink: 0;
    }

    .bio-card-header h2 {
      font-size: 1rem;
      color: var(--gold-pale);
      font-weight: 700;
    }

    .bio-quote-text {
      font-size: 0.86rem;
      color: var(--text-light);
      line-height: 1.75;
      text-align: justify;
    }

    /* Key Impact Metrics */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      margin-top: 14px;
    }

    .metric-card {
      background: rgba(4, 15, 10, 0.75);
      border: 1px solid rgba(212, 175, 55, 0.28);
      border-radius: var(--r-md);
      padding: 12px 10px;
      text-align: center;
      transition: transform 0.25s ease, border-color 0.25s ease;
    }

    .metric-card:hover {
      transform: translateY(-2px);
      border-color: var(--gold-bright);
    }

    .metric-num {
      font-family: var(--font-latin);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--gold-bright);
      line-height: 1.2;
    }

    .metric-lbl {
      font-size: 0.72rem;
      color: var(--gold-muted);
      margin-top: 4px;
      font-weight: 600;
      line-height: 1.35;
    }

    /* All Channels Section */
    .channels-stack {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .channels-stack .channel-card {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.5s var(--ease-luxury), transform 0.5s var(--ease-luxury), background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .channels-section.is-visible .channel-card,
    .portal-loaded .channels-section .channel-card {
      opacity: 1;
      transform: translateY(0);
    }

    .channels-stack .channel-card:nth-child(1)  { transition-delay: 0.04s; }
    .channels-stack .channel-card:nth-child(2)  { transition-delay: 0.08s; }
    .channels-stack .channel-card:nth-child(3)  { transition-delay: 0.12s; }
    .channels-stack .channel-card:nth-child(4)  { transition-delay: 0.16s; }
    .channels-stack .channel-card:nth-child(5)  { transition-delay: 0.20s; }
    .channels-stack .channel-card:nth-child(6)  { transition-delay: 0.24s; }
    .channels-stack .channel-card:nth-child(7)  { transition-delay: 0.28s; }
    .channels-stack .channel-card:nth-child(8)  { transition-delay: 0.32s; }
    .channels-stack .channel-card:nth-child(9)  { transition-delay: 0.36s; }
    .channels-stack .channel-card:nth-child(10) { transition-delay: 0.40s; }
    .channels-stack .channel-card:nth-child(11) { transition-delay: 0.44s; }

    .channel-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: var(--r-md);
      background: var(--surface-card);
      border: var(--edge-gold);
      color: var(--text-white);
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }

    .channel-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: -130%;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 243, 184, 0.12), transparent);
      transform: skewX(-25deg);
      transition: left 0.75s ease;
      pointer-events: none;
    }

    .channel-card:hover::after {
      left: 150%;
    }

    .channel-card:hover {
      background: var(--surface-card-hover);
      border-color: var(--gold-bright);
      transform: translateY(-3px) scale(1.008);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.85), 0 0 18px rgba(212, 175, 55, 0.22);
    }

    .channel-card:hover .channel-icon-wrap {
      transform: scale(1.08) rotate(2deg);
    }

    .channel-icon-wrap {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
      transition: transform 0.25s var(--ease-luxury);
    }

    .channel-icon-wrap svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .channel-info {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .channel-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-white);
    }

    .channel-sub {
      font-size: 0.73rem;
      color: var(--gold-pale);
      font-family: var(--font-latin);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      direction: ltr;
      text-align: left;
    }

    [dir="rtl"] .channel-sub {
      text-align: right;
    }

    .channel-badge {
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: var(--r-pill);
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid rgba(212, 175, 55, 0.35);
      color: var(--gold-bright);
      font-weight: 600;
      flex-shrink: 0;
    }

    /* Branded Channel Icon Gradients */
    .icon-whatsapp { background: #25D366; color: #fff; }
    .icon-linkedin { background: #0A66C2; color: #fff; }
    .icon-instagram { background: linear-gradient(135deg, #833AB4, #FD1D1D, #FCAF45); color: #fff; }
    .icon-facebook { background: #1877F2; color: #fff; }
    .icon-tiktok { background: #000000; color: #fff; border: 1px solid rgba(255,255,255,0.25); }
    .icon-telegram { background: #229ED9; color: #fff; }
    .icon-snapchat { background: #FFFC00; box-shadow: 0 4px 12px rgba(255, 252, 0, 0.35); }
    .icon-snapchat svg { fill: #FFFFFF !important; }
    .icon-researchgate { background: #00CCBB; color: #fff; }
    .icon-orcid { background: #A6CE39; color: #fff; }
    .icon-usthb { background: linear-gradient(135deg, #09472e 0%, #15734d 100%); color: var(--gold-bright); border: 1px solid rgba(212,175,55,0.4); }
    .icon-gmail { background: #EA4335; color: #fff; }

    /* Live Status Beacon */
    .beacon-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 6px;
      padding: 4px 11px;
      border-radius: 999px;
      background: rgba(37, 211, 102, 0.12);
      border: 1px solid rgba(37, 211, 102, 0.35);
      font-size: 0.73rem;
      font-weight: 600;
      color: #6CFCA6;
      width: fit-content;
    }

    .beacon-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #25D366;
      box-shadow: 0 0 8px #25D366;
      animation: beaconFlash 1.8s infinite ease-in-out;
    }

    @keyframes beaconFlash {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    /* Core Competencies */
    .competency-wrap {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px dashed rgba(212, 175, 55, 0.25);
    }

    .competency-title {
      font-size: 0.74rem;
      color: var(--gold-pale);
      font-weight: 700;
      margin-bottom: 8px;
    }

    .competency-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .comp-tag {
      font-size: 0.7rem;
      padding: 4px 9px;
      border-radius: var(--r-pill);
      background: rgba(212, 175, 55, 0.08);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--text-light);
      font-weight: 600;
      transition: all 0.25s ease;
    }

    .comp-tag:hover {
      background: rgba(212, 175, 55, 0.22);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
      transform: translateY(-1px);
    }

    /* Digital QR Business Card Modal */
    .qr-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 5000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.35s var(--ease-luxury), visibility 0.35s ease;
    }

    .qr-modal.is-active {
      opacity: 1;
      visibility: visible;
    }

    .qr-modal-card {
      background: linear-gradient(180deg, rgba(16, 46, 32, 0.98) 0%, rgba(4, 14, 10, 0.99) 100%);
      border: var(--edge-gold-strong);
      border-radius: var(--r-lg);
      padding: 24px 20px;
      max-width: 380px;
      width: 100%;
      text-align: center;
      position: relative;
      box-shadow: 0 25px 60px rgba(0,0,0,0.9), 0 0 35px rgba(212,175,55,0.3);
      transform: scale(0.92) translateY(20px);
      transition: transform 0.35s var(--ease-luxury);
    }

    .qr-modal.is-active .qr-modal-card {
      transform: scale(1) translateY(0);
    }

    .qr-modal-close {
      position: absolute;
      top: 14px;
      left: 14px;
      background: rgba(212, 175, 55, 0.15);
      border: 1px solid rgba(212, 175, 55, 0.4);
      color: var(--gold-bright);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.4rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      transition: all 0.2s ease;
    }

    .qr-modal-close:hover {
      background: var(--gold);
      color: #000;
    }

    .qr-modal-avatar-frame {
      position: relative;
      width: 72px;
      height: 72px;
      margin: 0 auto 10px;
      border-radius: 50%;
      padding: 3px;
      background: linear-gradient(135deg, var(--gold-pale), var(--gold-dark));
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
    }

    .qr-modal-avatar {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      object-position: center 20%;
    }

    .qr-avatar-badge {
      position: absolute;
      bottom: 0;
      right: 0;
      background: #25D366;
      color: #fff;
      font-size: 0.65rem;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      border: 2px solid #05140E;
    }

    .qr-modal-name {
      font-size: 1.15rem;
      color: var(--gold-bright);
      font-weight: 800;
      font-family: var(--font-ar-serif);
      margin-bottom: 2px;
    }

    .qr-modal-title {
      font-size: 0.78rem;
      color: var(--text-dim);
      font-weight: 600;
      margin-bottom: 14px;
    }

    .qr-code-box {
      background: #FFFFFF;
      padding: 14px;
      border-radius: var(--r-md);
      display: inline-block;
      box-shadow: 0 8px 25px rgba(0,0,0,0.6);
      margin-bottom: 10px;
      border: 2px solid var(--gold);
    }

    .qr-code-img {
      width: 170px;
      height: 170px;
      display: block;
      margin: 0 auto;
    }

    .qr-scan-hint {
      font-size: 0.78rem;
      color: var(--gold-pale);
      margin-bottom: 14px;
      font-weight: 600;
    }

    .qr-modal-actions {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* Floating Quick Executive Dock */
    .floating-dock {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%) translateY(90px);
      opacity: 0;
      visibility: hidden;
      z-index: 4000;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 12px;
      background: rgba(5, 18, 12, 0.90);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(212, 175, 55, 0.45);
      border-radius: 999px;
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.85), 0 0 20px rgba(212, 175, 55, 0.25);
      transition: transform 0.4s var(--ease-luxury), opacity 0.4s ease, visibility 0.4s ease;
    }

    .floating-dock.is-visible {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .dock-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.35);
      color: var(--gold-bright);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s var(--ease-luxury);
      position: relative;
    }

    .dock-btn svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
      transition: transform 0.25s ease;
    }

    .dock-btn:hover {
      transform: translateY(-3px) scale(1.1);
      border-color: var(--gold-bright);
      box-shadow: 0 6px 16px rgba(212, 175, 55, 0.4);
    }

    .dock-btn:hover svg {
      transform: scale(1.1);
    }

    .dock-btn-wa {
      background: #25D366;
      border-color: #25D366;
      color: #FFFFFF;
    }

    .dock-btn-wa:hover {
      box-shadow: 0 6px 18px rgba(37, 211, 102, 0.55);
    }

    .dock-btn-vcard {
      background: linear-gradient(135deg, #F5E6A3 0%, #D4AF37 100%);
      border-color: #FFF3B8;
      color: #030E08;
    }

    .dock-btn-vcard:hover {
      box-shadow: 0 6px 18px rgba(212, 175, 55, 0.6);
    }

    @media (max-width: 380px) {
      .cred-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Interactive Channel Filter Bar */
    .channel-filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin: 4px 0 16px;
    }

    .filter-pill {
      background: rgba(212, 175, 55, 0.08);
      border: 1px solid rgba(212, 175, 55, 0.28);
      color: var(--text-muted);
      padding: 6px 14px;
      border-radius: var(--r-pill);
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s var(--ease-luxury);
    }

    .filter-pill:hover {
      background: rgba(212, 175, 55, 0.18);
      border-color: var(--gold);
      color: var(--gold-bright);
      transform: translateY(-1px);
    }

    .filter-pill.is-active {
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.3) 0%, rgba(212, 175, 55, 0.15) 100%);
      border-color: var(--gold-bright);
      color: var(--gold-bright);
      box-shadow: 0 0 12px rgba(212, 175, 55, 0.25);
    }

    .channel-card.is-filtered-out {
      display: none !important;
    }

    /* Channel Quick Copy Email Button */
    .channel-copy-btn {
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid rgba(212, 175, 55, 0.3);
      color: var(--gold-pale);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-inline-start: auto;
      margin-inline-end: 8px;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .channel-copy-btn:hover {
      background: var(--gold);
      color: #04120C;
      border-color: var(--gold-bright);
      transform: scale(1.08);
    }

    .channel-copy-btn svg {
      width: 15px;
      height: 15px;
      fill: currentColor;
    }

    /* Executive Print Stylesheet */
    @media print {
      body {
        background: #fff !important;
        color: #111 !important;
      }
      #particles-canvas, .preloader, .floating-dock, .qr-modal, .lang-bar, .channel-filter-bar, .channel-copy-btn {
        display: none !important;
      }
      .portal-container {
        padding: 0 !important;
        max-width: 100% !important;
      }
      .sovereign-header, .hero-section, .authority-banner, .bio-card, .cta-grid, .channels-section, .credential-card, .pillars-section, .sovereign-footer {
        border: 1px solid #ddd !important;
        background: #fff !important;
        box-shadow: none !important;
        color: #111 !important;
      }
      .person-name-ar, .person-name-en, .tier-heading, .section-header h2, .pillar-card-title {
        color: #0b3b24 !important;
      }
      .channel-card {
        border: 1px solid #ccc !important;
        background: #fbfbfb !important;
        break-inside: avoid;
      }
      .channel-title, .channel-sub {
        color: #222 !important;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <!-- Particle Background Canvas -->
  <canvas id="particles-canvas"></canvas>

  <!-- Sovereign Executive Preloader -->
  <div class="preloader" id="preloader" role="status" aria-live="polite">
    <div class="preloader-backdrop"></div>
    <div class="preloader-inner">
      <!-- Sovereign Medallion with rotating concentric golden rings -->
      <div class="preloader-emblem-wrap">
        <div class="preloader-glow-aura"></div>
        <div class="preloader-ring-pulse"></div>
        <div class="preloader-ring-outer"></div>
        <div class="preloader-ring-inner"></div>
        <div class="preloader-center-seal">
          <svg viewBox="0 0 48 48" class="preloader-seal-svg" aria-hidden="true">
            <path d="M24 4l5.5 11.2L42 17l-9 8.8 2.1 12.4L24 32.4 12.9 38.2 15 25.8 6 17l12.5-1.8L24 4z" fill="url(#goldGradSeal)"/>
            <circle cx="24" cy="24" r="5" fill="#04120C" stroke="#FFF3B8" stroke-width="1.5"/>
            <defs>
              <linearGradient id="goldGradSeal" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFF3B8"/>
                <stop offset="50%" stop-color="#D4AF37"/>
                <stop offset="100%" stop-color="#9B7415"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>

      <!-- Identity -->
      <div class="preloader-identity">
        <div class="preloader-name">د. أبو اليقظان باكلي</div>
        <div class="preloader-inst">USTHB • TECHINNOV Incubator</div>
      </div>

      <!-- Progress Track & Counter -->
      <div class="preloader-bar-wrap">
        <div class="preloader-bar-track">
          <div class="preloader-bar-fill" id="preloader-bar-fill"></div>
        </div>
        <div class="preloader-status-row">
          <span class="preloader-label" id="preloader-text">جاري تحميل البوابة الرسمية...</span>
          <span class="preloader-percent" id="preloader-percent">0%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-msg" id="toast-notification">تم النسخ بنجاح</div>

  <!-- Main Container -->
  <main class="portal-container">
    
    <!-- Language Switcher Bar -->
    <nav class="lang-bar" aria-label="Language selection">
      <button type="button" class="lang-btn active" data-lang="ar" id="btn-lang-ar">العربية</button>
      <button type="button" class="lang-btn" data-lang="fr" id="btn-lang-fr">Français</button>
      <button type="button" class="lang-btn" data-lang="en" id="btn-lang-en">English</button>
    </nav>

    <!-- Sovereign Top Header -->
    <header class="sovereign-header anim-reveal">
      <div class="header-crest" aria-label="علم الجمهورية الجزائرية الديمقراطية الشعبية">
        <!-- Official Flag of Algeria to Scale -->
        <img 
          src="algeria-flag.png" 
          alt="علم الجمهورية الجزائرية الديمقراطية الشعبية" 
          class="flag-crest-img"
          onerror="this.src='algeria-flag.svg'"
        >
      </div>
      <h2 class="republic-ar" id="txt-republic-ar">الجمهورية الجزائرية الديمقراطية الشعبية</h2>
      <div class="republic-en" id="txt-republic-en">People's Democratic Republic of Algeria</div>
      <div class="header-rule"></div>
      <h3 class="org-title" id="txt-org-title">جامعة العلوم والتكنولوجيا هواري بومدين • USTHB</h3>
      <div class="org-sub" id="txt-org-sub">حاضنة الأعمال والتكنولوجيا • TECHINNOV Incubator</div>
      <div class="pillars-pill" id="txt-pillars-pill">
        <span>تعليم عالي</span> • <span>بحث علمي</span> • <span>ابتكار وريادة أعمال</span>
      </div>
    </header>

    <!-- Hero Portrait with Embedded Gold Plaque -->
    <section class="hero-section anim-reveal" aria-label="Portrait officiel">
      <div class="hero-portrait-frame">
        <!-- Master Official Portrait -->
        <img 
          src="portrait.jpg" 
          alt="د. أبو اليقظان باكلي - مدير حاضنة TECHINNOV وأستاذ محاضر" 
          class="hero-img"
          id="hero-portrait-img"
          onerror="this.src='portrait.jpg'"
        >

        <!-- Coordinates locked inside the golden cartouche at the bottom of the portrait -->
        <div class="picture-gold-box-content">
          <div class="verified-mini-badge">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/>
            </svg>
