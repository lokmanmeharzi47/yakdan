    </button>
    <button type="button" class="dock-btn" onclick="playLuxuryClick(); window.scrollTo({top: 0, behavior: 'smooth'})" title="للأعلى" aria-label="للأعلى">
      <svg viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
    </button>
  </nav>

  <!-- Ambient Golden Dust Particles Script -->
  <script>
    (function initParticles() {
      const canvas = document.getElementById('particles-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let width, height;
      let particles = [];

      let pointerX = -999, pointerY = -999;
      window.addEventListener('mousemove', (e) => {
        pointerX = e.clientX;
        pointerY = e.clientY;
      }, { passive: true });
      window.addEventListener('touchmove', (e) => {
        if (e.touches && e.touches[0]) {
          pointerX = e.touches[0].clientX;
          pointerY = e.touches[0].clientY;
        }
      }, { passive: true });

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize, { passive: true });

      const count = Math.min(48, Math.floor(window.innerWidth / 10));
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: Math.random() * 2.2 + 0.6,
          speedY: -(Math.random() * 0.45 + 0.15),
          speedX: (Math.random() - 0.5) * 0.25,
          alpha: Math.random() * 0.6 + 0.2,
          fadeSpeed: (Math.random() * 0.008 + 0.003) * (Math.random() > 0.5 ? 1 : -1)
        });
      }

      function loop() {
        ctx.clearRect(0, 0, width, height);
        for (let p of particles) {
          // Interactive gentle deflection
          const dx = p.x - pointerX;
          const dy = p.y - pointerY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 90) {
            const force = (90 - dist) / 90;
            p.x += (dx / dist) * force * 1.6;
            p.y += (dy / dist) * force * 1.6;
          }

          p.y += p.speedY;
          p.x += p.speedX;
          p.alpha += p.fadeSpeed;
          if (p.alpha > 0.85 || p.alpha < 0.15) p.fadeSpeed *= -1;

          if (p.y < -10) {
            p.y = height + 10;
            p.x = Math.random() * width;
          }
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(212, 175, 55, ${Math.max(0, p.alpha)})`;
          ctx.shadowBlur = 8;
          ctx.shadowColor = 'rgba(255, 243, 184, 0.6)';
          ctx.fill();
        }
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);
    })();
  </script>

  <!-- Interaction, Multilingual Engine & vCard Logic -->
  <script>
    // Live Impact Metrics Counter
    function initCounters() {
      const counters = document.querySelectorAll('[data-counter]');
      counters.forEach(counter => {
        if (counter.dataset.counted === 'true') return;
        
        const target = parseInt(counter.dataset.counter, 10);
        const prefix = counter.dataset.prefix || '';
        const duration = 1400;
        const startTimestamp = performance.now();

        function step(timestamp) {
          const elapsed = timestamp - startTimestamp;
          const progress = Math.min(elapsed / duration, 1);
          // Ease out cubic
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentVal = Math.floor(easeProgress * target);
          counter.textContent = prefix + currentVal.toLocaleString('en-US');

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            counter.textContent = prefix + target.toLocaleString('en-US');
            counter.dataset.counted = 'true';
          }
        }
        requestAnimationFrame(step);
      });
    }

    // Coordinated Hero Reveal Animation
    function triggerHeroReveals() {
      const heroGroup = document.querySelectorAll('.sovereign-header, .hero-section, .authority-banner');
      heroGroup.forEach((el, index) => {
        setTimeout(() => el.classList.add('is-visible'), index * 80);
      });
      initCounters();
    }

    // High-End Sovereign Preloader & Progress Simulation
    (function initPreloader() {
      const preloader = document.getElementById('preloader');
      const barFill = document.getElementById('preloader-bar-fill');
      const percentEl = document.getElementById('preloader-percent');
      if (!preloader) return;

      let progress = 0;
      let windowLoaded = false;

      window.addEventListener('load', () => {
        windowLoaded = true;
      });

      const interval = setInterval(() => {
        if (!windowLoaded) {
          // Progress quickly to ~80%
          if (progress < 80) {
            progress += Math.floor(Math.random() * 9) + 4;
            if (progress > 80) progress = 80;
          }
        } else {
          // Surge to 100% on complete asset load
          progress += Math.floor(Math.random() * 16) + 12;
          if (progress >= 100) {
            progress = 100;
            clearInterval(interval);
            if (barFill) barFill.style.width = '100%';
            if (percentEl) percentEl.textContent = '100%';

            setTimeout(() => {
              preloader.classList.add('is-hidden');
              document.body.classList.add('portal-loaded');
              setTimeout(triggerHeroReveals, 100);
            }, 240);
            return;
          }
        }

        if (barFill) barFill.style.width = progress + '%';
        if (percentEl) percentEl.textContent = progress + '%';
      }, 30);

      // Failsafe timeout at 3s
      setTimeout(() => {
        if (!preloader.classList.contains('is-hidden')) {
          clearInterval(interval);
          if (barFill) barFill.style.width = '100%';
          if (percentEl) percentEl.textContent = '100%';
          preloader.classList.add('is-hidden');
          document.body.classList.add('portal-loaded');
          setTimeout(triggerHeroReveals, 100);
        }
      }, 3000);
    })();

    // Intersection Observer for Smooth Reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          if (entry.target.classList.contains('bio-card')) {
            initCounters();
          }
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.anim-reveal').forEach(el => observer.observe(el));

    // Toast Notification Utility
    function showToast(msg) {
      const toast = document.getElementById('toast-notification');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2600);
    }

    // Share Profile
    async function shareProfile() {
      const shareData = {
        title: 'Dr. Aboulyakdane BAKELLI | د. أبو اليقظان باكلي',
        text: 'الملف المهني والأكاديمي الرسمي للدكتور أبو اليقظان باكلي - مدير حاضنة الأعمال TECHINNOV وأستاذ محاضر بجامعة USTHB',
        url: window.location.href
      };
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {
          copyCurrentLink();
        }
      } else {
        copyCurrentLink();
      }
    }

    function copyCurrentLink() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        showToast(document.documentElement.lang === 'fr' ? 'Lien officiel copié avec succès' : (document.documentElement.lang === 'en' ? 'Official link copied successfully' : 'تم نسخ رابط الملف التعريفي بنجاح'));
      }).catch(() => {
        showToast(document.documentElement.lang === 'fr' ? 'Échec de la copie' : (document.documentElement.lang === 'en' ? 'Failed to copy' : 'تعذر النسخ التلقائي'));
      });
    }

    // Generate & Download vCard (.vcf)
    function downloadVCard() {
      const vcardData = [
        'BEGIN:VCARD',
        'VERSION:3.0',
        'N:BAKELLI;Aboulyakdane;Dr.;;',
        'FN:Dr. Aboulyakdane BAKELLI (د. أبو اليقظان باكلي)',
        'ORG:Université des Sciences et de la Technologie Houari Boumediene (USTHB);TECHINNOV Incubator',
        'TITLE:Director of TECHINNOV Incubator | Associate Professor (USTHB)',
        'EMAIL;TYPE=PREF,INTERNET:aboulyakdane.bakelli@usthb.edu.dz',
        'EMAIL;TYPE=WORK,INTERNET:yakdane.bakelli@gmail.com',
        'URL;TYPE=LinkedIn:https://www.linkedin.com/in/yakdanebk',
        'URL;TYPE=WhatsApp:https://wa.me/qr/VOLOK6MFREQSH1',
        'URL;TYPE=ResearchGate:https://www.researchgate.net/profile/Aboulyakdane-Bakelli-2',
        'URL;TYPE=ORCID:https://orcid.org/0000-0002-5607-5410',
        'NOTE:Geologist & Associate Professor (USTHB) | Director of TECHINNOV-USTHB Incubator | Former Dean of Students | 1300+ Project Holders Trained | 1200+ Training Hours',
        'END:VCARD'
      ].join('\r\n');

      const blob = new Blob([vcardData], { type: 'text/vcard;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', 'Dr_Aboulyakdane_Bakelli_USTHB_Contact.vcf');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast(document.documentElement.lang === 'fr' ? 'Carte de contact téléchargée' : (document.documentElement.lang === 'en' ? 'Contact card downloaded' : 'تم تحميل بطاقة الاتصال الرسمية'));
    }

    // Specific text copier with feedback
    function copySpecificText(event, text, successMsg) {
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      playLuxuryClick('confirm');
      navigator.clipboard.writeText(text).then(() => {
        showToast(successMsg || 'تم النسخ بنجاح');
      }).catch(() => {
        showToast('تعذر النسخ التلقائي');
      });
    }

    // Interactive Channel Filter
    function filterChannels(category, btn) {
      playLuxuryClick();
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('is-active'));
      if (btn) btn.classList.add('is-active');

      const cards = document.querySelectorAll('.channels-stack .channel-card');
      cards.forEach(card => {
        const cat = card.dataset.category || '';
        if (category === 'all' || cat.split(' ').includes(category)) {
          card.classList.remove('is-filtered-out');
        } else {
          card.classList.add('is-filtered-out');
        }
      });
    }

    // Digital QR Business Card Modal Handlers
    function openQrModal() {
      const modal = document.getElementById('qrModal');
      if (!modal) return;
      const qrImg = document.getElementById('qrCodeImg');
      if (qrImg) {
        qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=260x260&color=05150E&bgcolor=FFFFFF&data=' + encodeURIComponent(window.location.href);
      }
      modal.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeQrModal(event) {
      if (event && event.target && event.target !== event.currentTarget && !event.target.classList.contains('qr-modal-close')) {
        return;
      }
      const modal = document.getElementById('qrModal');
      if (modal) {
        modal.classList.remove('is-active');
        document.body.style.overflow = '';
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeQrModal();
    });

    // Floating Quick Executive Dock Scroll Revealer
    window.addEventListener('scroll', () => {
      const dock = document.getElementById('floatingDock');
      if (!dock) return;
      if (window.scrollY > 300) {
        dock.classList.add('is-visible');
      } else {
        dock.classList.remove('is-visible');
      }
    }, { passive: true });

    // Tactile Luxury Sound Synthesizer (Web Audio API)
    let audioCtx = null;
    let soundEnabled = true;

    function toggleAudio() {
      soundEnabled = !soundEnabled;
      const icon = document.getElementById('dock-sound-icon');
      if (icon) {
        if (soundEnabled) {
          icon.innerHTML = '<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>';
          showToast(document.documentElement.lang === 'fr' ? 'Son interactif activé' : (document.documentElement.lang === 'en' ? 'Interactive sound enabled' : 'تم تفعيل المؤثرات الصوتية'));
          playLuxuryClick('confirm');
        } else {
          icon.innerHTML = '<path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>';
          showToast(document.documentElement.lang === 'fr' ? 'Son interactif désactivé' : (document.documentElement.lang === 'en' ? 'Interactive sound muted' : 'تم كتم المؤثرات الصوتية'));
        }
      }
    }

    function playLuxuryClick(type = 'default') {
      if (!soundEnabled) return;
      try {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;
        if (!audioCtx) audioCtx = new AudioContextClass();
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'confirm') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(880, now);
          osc.frequency.exponentialRampToValueAtTime(1320, now + 0.08);
          gain.gain.setValueAtTime(0.04, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);
          osc.start(now);
          osc.stop(now + 0.09);
        } else {
          osc.type = 'sine';
          osc.frequency.setValueAtTime(960, now);
          osc.frequency.exponentialRampToValueAtTime(520, now + 0.04);
          gain.gain.setValueAtTime(0.025, now);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.045);
          osc.start(now);
          osc.stop(now + 0.045);
        }
      } catch (err) {
        // Silently handle if audio policy prevents autoplay
      }
    }

    // Subtle 3D Tilt Effect on Desktop Pointer
    (function initTilt() {
      const heroFrame = document.querySelector('.hero-portrait-frame');
      if (!heroFrame || window.matchMedia('(pointer: coarse)').matches) return;
      heroFrame.addEventListener('mousemove', (e) => {
        const rect = heroFrame.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        const rotX = -(y / (rect.height / 2)) * 6;
        const rotY = (x / (rect.width / 2)) * 6;
        heroFrame.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale3d(1.01, 1.01, 1.01)`;
      });
      heroFrame.addEventListener('mouseleave', () => {
        heroFrame.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    })();

