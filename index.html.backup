    function applyLanguage(lang) {
      const data = translations[lang] || translations.ar;
      document.documentElement.lang = lang;
      document.documentElement.dir = data.dir;

      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el && val !== undefined) el.textContent = val;
      };
      const setHtml = (id, val) => {
        const el = document.getElementById(id);
        if (el && val !== undefined) el.innerHTML = val;
      };

      setTxt('preloader-text', data.preloader);
      setTxt('txt-republic-ar', data.republicAr);
      setTxt('txt-republic-en', data.republicEn);
      setTxt('txt-org-title', data.orgTitle);
      setTxt('txt-org-sub', data.orgSub);
      setHtml('txt-pillars-pill', data.pillarsPill);
      setTxt('txt-badge-status', data.badgeStatus);
      setTxt('txt-person-name-ar', data.personNameAr);
      setTxt('txt-person-name-en', data.personNameEn);
      setTxt('txt-person-title', data.personTitle);
      setTxt('txt-banner-title', data.bannerTitle);
      setTxt('txt-banner-sub', data.bannerSub);
      setTxt('txt-beacon-status', data.beaconStatus);

      setTxt('txt-bio-heading', data.bioHeading);
      setTxt('txt-bio-desc', data.bioDesc);
      setTxt('lbl-metric-1', data.metric1);
      setTxt('lbl-metric-2', data.metric2);
      setTxt('lbl-metric-3', data.metric3);
      setTxt('lbl-metric-4', data.metric4);
      setTxt('txt-comp-title', data.compTitle);

      setTxt('btn-save-contact', data.btnSaveContact);
      setTxt('btn-top-whatsapp-txt', data.btnTopWhatsApp);
      setTxt('btn-qr-card-txt', data.btnQrCard);
      setTxt('btn-share-profile', data.btnShareProfile);

      setTxt('txt-channels-heading', data.channelsHeading);
      setTxt('badge-wa', data.badgeWa);
      setTxt('lbl-ch-usthb', data.chUsthb);
      setTxt('lbl-ch-gmail', data.chGmail);

      setTxt('filter-tab-all', data.filterAll);
      setTxt('filter-tab-academic', data.filterAcademic);
      setTxt('filter-tab-direct', data.filterDirect);
      setTxt('filter-tab-social', data.filterSocial);

      setTxt('txt-qr-modal-name', data.qrModalName);
      setTxt('txt-qr-modal-title', data.qrModalTitle);
      setTxt('txt-qr-hint', data.qrHint);
      setTxt('txt-qr-btn-vcard', data.qrBtnVcard);
      setTxt('txt-qr-btn-copy', data.qrBtnCopy);

      setTxt('txt-cred-title', data.credTitle);
      setTxt('lbl-full-name', data.lblFullName);
      setTxt('val-full-name', data.valFullName);
      setTxt('lbl-role', data.lblRole);
      setTxt('val-role', data.valRole);
      setTxt('lbl-pos', data.lblPos);
      setTxt('val-pos', data.valPos);
      setTxt('lbl-inst', data.lblInst);
      setTxt('val-inst', data.valInst);
      setTxt('lbl-field', data.lblField);
      setTxt('val-field', data.valField);
      setTxt('lbl-prev', data.lblPrev);
      setTxt('val-prev', data.valPrev);
      setTxt('lbl-orcid', data.lblOrcid);
      setTxt('lbl-impact', data.lblImpact);
      setTxt('val-impact', data.valImpact);

      setTxt('txt-pillars-heading', data.pillarsHeading);
      setTxt('txt-p1-title', data.p1Title);
      setTxt('txt-p1-desc', data.p1Desc);
      setTxt('txt-p2-title', data.p2Title);
      setTxt('txt-p2-desc', data.p2Desc);
      setTxt('txt-p3-title', data.p3Title);
      setTxt('txt-p3-desc', data.p3Desc);

      setTxt('txt-foot-org', data.footOrg);
      setTxt('txt-foot-sub', data.footSub);

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === lang);
      });
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        applyLanguage(btn.dataset.lang);
      });
    });
  </script>
</body>
</html>