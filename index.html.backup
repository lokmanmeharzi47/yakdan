          </div>

          <h1 class="person-name-ar" id="txt-person-name-ar">د. أبو اليقظان باكلي</h1>
          <div class="person-name-en" id="txt-person-name-en">Dr. Aboulyakdane BAKELLI</div>
          
          <div class="gold-divider"></div>
          
          <p class="person-title" id="txt-person-title">مدير حاضنة TECHINNOV • أستاذ محاضر USTHB</p>
        </div>
      </div>
    </section>

    <!-- Executive Authority Banner -->
    <section class="authority-banner anim-reveal" aria-label="الصفة الرسمية">
      <div class="authority-banner-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z"/>
        </svg>
      </div>
      <div class="authority-banner-text">
        <strong id="txt-banner-title">مدير حاضنة الأعمال TECHINNOV - USTHB</strong>
        <span id="txt-banner-sub">أستاذ محاضر وباحث • مهندس ومطور لمنظومة ريادة الأعمال</span>
        <div class="beacon-status-pill">
          <span class="beacon-dot"></span>
          <span id="txt-beacon-status">متاح للشراكات الريادية والتأطير الأكاديمي والابتكار</span>
        </div>
      </div>
    </section>

    <!-- Executive Bio & Vision Card -->
    <section class="bio-card anim-reveal" aria-label="النبذة التعريفية">
      <div class="bio-card-header">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/>
        </svg>
        <h2 id="txt-bio-heading">النبذة المهنية ورؤية الابتكار</h2>
      </div>
      <p class="bio-quote-text" id="txt-bio-desc">
        أستاذ محاضر وباحث في علم الجيولوجيا، ومدير حاضنة الأعمال TECHINNOV بجامعة العلوم والتكنولوجيا هواري بومدين (USTHB)، متمرس في التصميم التعليمي، الابتكار البيداغوجي، وريادة الأعمال. أعمل في نقطة التقاء التعليم العالي والبحث العلمي التطبيقي ومنظومات الشركات الناشئة لتحويل المعرفة إلى أثر حقيقي وملموس. درّبت أكثر من 1,300 صاحب مشروع في التفكير التصميمي ومخطط نموذج العمل التجاري مع تقديم أكثر من 1,200 ساعة تدريبية. عميد سابق لشؤون الطلبة، وأعمل حالياً كمهندس للابتكار، مرشد وموجّه، ومطور لبيئة ريادة الأعمال.
      </p>

      <!-- Key Impact Metrics -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-num" data-counter="1300" data-prefix="+">+1,300</div>
          <div class="metric-lbl" id="lbl-metric-1">صاحب مشروع مدرّب</div>
        </div>
        <div class="metric-card">
          <div class="metric-num" data-counter="1200" data-prefix="+">+1,200</div>
          <div class="metric-lbl" id="lbl-metric-2">ساعة تدريب واستشارة</div>
        </div>
        <div class="metric-card">
          <div class="metric-num">TECHINNOV</div>
          <div class="metric-lbl" id="lbl-metric-3">إدارة حاضنة الأعمال</div>
        </div>
        <div class="metric-card">
          <div class="metric-num">USTHB</div>
          <div class="metric-lbl" id="lbl-metric-4">أستاذ محاضر وباحث</div>
        </div>
      </div>

